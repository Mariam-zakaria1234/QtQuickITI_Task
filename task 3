import QtQuick
import QtQuick.Controls

Window {
    width: 640
    height: 480
    visible: true
    title: qsTr("Smart Home Control Panel")
    color: "#0f172a"

    StackView {
        id: stackView
        anchors.fill: parent
        initialItem: loginPage


        Component {
            id: loginPage
            Rectangle {
                color: "#0f172a"

                Rectangle {
                    width: 380
                    height: 360
                    anchors.centerIn: parent
                    color: "#1e293b"
                    radius: 20
                    border.color: "#334155"
                    border.width: 1

                    Column {
                        anchors.centerIn: parent
                        spacing: 18
                        width: parent.width - 60

                        Text {
                            text: "Welcome Back"
                            color: "#ffffff"
                            font.pixelSize: 26
                            font.bold: true
                            anchors.horizontalCenter: parent.horizontalCenter
                        }

                        Text {
                            text: "Sign in to control your smart home"
                            color: "#94a3b8"
                            font.pixelSize: 13
                            anchors.horizontalCenter: parent.horizontalCenter
                        }

                        Item { width: 1; height: 5 }

                        TextField {
                            id: mynameField
                            placeholderText: "User name"
                            width: parent.width
                            color: "white"
                            placeholderTextColor: "#64748b"
                            background: Rectangle {
                                color: "#0f172a"
                                radius: 10
                                border.color: mynameField.activeFocus ? "#38bdf8" : "#334155"
                            }
                        }

                        TextField {
                            id: mypasswordField
                            placeholderText: "Password"
                            width: parent.width
                            color: "white"
                            placeholderTextColor: "#64748b"
                            echoMode: TextInput.Password
                            background: Rectangle {
                                color: "#0f172a"
                                radius: 10
                                border.color: mypasswordField.activeFocus ? "#38bdf8" : "#334155"
                            }
                        }

                        Button {
                            text: "Login"
                            width: parent.width
                            height: 45
                            contentItem: Text {
                                text: parent.text
                                color: "white"
                                font.bold: true
                                font.pixelSize: 15
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                            }
                            background: Rectangle {
                                color: parent.down ? "#0284c7" : "#0ea5e9"
                                radius: 10
                            }
                            onClicked: {
                                stackView.push(devicesListPage)
                            }
                        }
                    }
                }
            }
        }


        Component {
            id: devicesListPage
            Rectangle {
                color: "#0f172a"

                Rectangle {
                    width: 380
                    height: 420
                    anchors.centerIn: parent
                    color: "#1e293b"
                    radius: 20
                    border.color: "#334155"
                    border.width: 1

                    Column {
                        anchors.fill: parent
                        anchors.margins: 20
                        spacing: 12

                        Text {
                            text: "Smart Devices"
                            color: "#ffffff"
                            font.pixelSize: 22
                            font.bold: true
                            anchors.horizontalCenter: parent.horizontalCenter
                        }

                        ScrollView {
                            id: scrollView
                            width: parent.width
                            height: 250
                            clip: true

                            contentWidth: availableColumn.width
                            contentHeight: availableColumn.height

                            Column {
                                id: availableColumn
                                width: 320
                                spacing: 10

                                Button {
                                    text: "Air Conditioner (AC)"
                                    width: parent.width
                                    height: 45
                                    contentItem: Text { text: parent.text; color: "white"; font.pixelSize: 14; font.bold: true; leftPadding: 15; verticalAlignment: Text.AlignVCenter }
                                    background: Rectangle { color: "#334155"; radius: 10 }
                                    onClicked: stackView.push(acSettingsPage)
                                }

                                Button {
                                    text: "Vacuum Cleaner"
                                    width: parent.width
                                    height: 45
                                    contentItem: Text { text: parent.text; color: "white"; font.pixelSize: 14; font.bold: true; leftPadding: 15; verticalAlignment: Text.AlignVCenter }
                                    background: Rectangle { color: "#334155"; radius: 10 }
                                    onClicked: stackView.push(vacuumSettingsPage)
                                }

                                Button {
                                    text: "Smart Lights"
                                    width: parent.width
                                    height: 45
                                    contentItem: Text { text: parent.text; color: "white"; font.pixelSize: 14; font.bold: true; leftPadding: 15; verticalAlignment: Text.AlignVCenter }
                                    background: Rectangle { color: "#334155"; radius: 10 }
                                    onClicked: stackView.push(lightsSettingsPage)
                                }

                                Button {
                                    text: "Smart TV"
                                    width: parent.width
                                    height: 45
                                    contentItem: Text { text: parent.text; color: "white"; font.pixelSize: 14; font.bold: true; leftPadding: 15; verticalAlignment: Text.AlignVCenter }
                                    background: Rectangle { color: "#334155"; radius: 10 }
                                    onClicked: stackView.push(tvSettingsPage)
                                }

                                Button {
                                    text: "Washing Machine"
                                    width: parent.width
                                    height: 45
                                    contentItem: Text { text: parent.text; color: "white"; font.pixelSize: 14; font.bold: true; leftPadding: 15; verticalAlignment: Text.AlignVCenter }
                                    background: Rectangle { color: "#334155"; radius: 10 }
                                    onClicked: stackView.push(washingSettingsPage)
                                }
                            }
                        }

                        Button {
                            text: "Logout"
                            width: parent.width
                            height: 38
                            anchors.horizontalCenter: parent.horizontalCenter
                            contentItem: Text { text: parent.text; color: "#f43f5e"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            background: Rectangle { color: "transparent"; radius: 10; border.color: "#f43f5e"; border.width: 1 }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }


        Component {
            id: acSettingsPage
            Rectangle {
                color: "#0f172a"
                Rectangle {
                    width: 380
                    height: 340
                    anchors.centerIn: parent
                    color: "#1e293b"
                    radius: 20
                    border.color: "#334155"

                    Column {
                        anchors.centerIn: parent
                        spacing: 20
                        width: parent.width - 40

                        Text {
                            text: "AC Control"
                            color: "white"
                            font.pixelSize: 22
                            font.bold: true
                            anchors.horizontalCenter: parent.horizontalCenter
                        }

                        Row {
                            spacing: 30
                            anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Power State:"; color: "#94a3b8"; font.pixelSize: 16; verticalAlignment: Text.AlignVCenter }
                            Switch { id: acSwitch }
                        }

                        Row {
                            spacing: 12
                            anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Temp:"; color: "#94a3b8"; verticalAlignment: Text.AlignVCenter }

                            Button {
                                text: "-"
                                width: 35; height: 35
                                background: Rectangle { color: "#334155"; radius: 8 }
                                contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                                onClicked: if (acSlider.value > 16) acSlider.value -= 1
                            }

                            Slider {
                                id: acSlider
                                from: 16; to: 30; value: 22
                                width: 130
                            }

                            Button {
                                text: "+"
                                width: 35; height: 35
                                background: Rectangle { color: "#334155"; radius: 8 }
                                contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                                onClicked: if (acSlider.value < 30) acSlider.value += 1
                            }
                        }

                        Text {
                            text: "Target: " + Math.round(acSlider.value) + " °C"
                            color: "#38bdf8"
                            font.bold: true
                            font.pixelSize: 16
                            anchors.horizontalCenter: parent.horizontalCenter
                        }

                        Button {
                            text: "Back to Devices"
                            width: parent.width
                            height: 40
                            background: Rectangle { color: "#334155"; radius: 8 }
                            contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }


        Component {
            id: vacuumSettingsPage
            Rectangle {
                color: "#0f172a"
                Rectangle {
                    width: 380; height: 260
                    anchors.centerIn: parent
                    color: "#1e293b"; radius: 20; border.color: "#334155"
                    Column {
                        anchors.centerIn: parent; spacing: 20; width: parent.width - 40
                        Text { text: "Vacuum Control"; color: "white"; font.pixelSize: 22; font.bold: true; anchors.horizontalCenter: parent.horizontalCenter }
                        Row {
                            spacing: 30; anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Power State:"; color: "#94a3b8"; font.pixelSize: 16; verticalAlignment: Text.AlignVCenter }
                            Switch { id: vacuumSwitch }
                        }
                        Button {
                            text: "Back to Devices"; width: parent.width; height: 40
                            background: Rectangle { color: "#334155"; radius: 8 }
                            contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }


        Component {
            id: lightsSettingsPage
            Rectangle {
                color: "#0f172a"
                Rectangle {
                    width: 380; height: 260
                    anchors.centerIn: parent
                    color: "#1e293b"; radius: 20; border.color: "#334155"
                    Column {
                        anchors.centerIn: parent; spacing: 20; width: parent.width - 40
                        Text { text: "Smart Lights Control"; color: "white"; font.pixelSize: 22; font.bold: true; anchors.horizontalCenter: parent.horizontalCenter }
                        Row {
                            spacing: 30; anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Power State:"; color: "#94a3b8"; font.pixelSize: 16; verticalAlignment: Text.AlignVCenter }
                            Switch { id: lightSwitch }
                        }
                        Button {
                            text: "Back to Devices"; width: parent.width; height: 40
                            background: Rectangle { color: "#334155"; radius: 8 }
                            contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }


        Component {
            id: tvSettingsPage
            Rectangle {
                color: "#0f172a"
                Rectangle {
                    width: 380; height: 260
                    anchors.centerIn: parent
                    color: "#1e293b"; radius: 20; border.color: "#334155"
                    Column {
                        anchors.centerIn: parent; spacing: 20; width: parent.width - 40
                        Text { text: "Smart TV Control"; color: "white"; font.pixelSize: 22; font.bold: true; anchors.horizontalCenter: parent.horizontalCenter }
                        Row {
                            spacing: 30; anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Power State:"; color: "#94a3b8"; font.pixelSize: 16; verticalAlignment: Text.AlignVCenter }
                            Switch { id: tvSwitch }
                        }
                        Button {
                            text: "Back to Devices"; width: parent.width; height: 40
                            background: Rectangle { color: "#334155"; radius: 8 }
                            contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }


        Component {
            id: washingSettingsPage
            Rectangle {
                color: "#0f172a"
                Rectangle {
                    width: 380; height: 260
                    anchors.centerIn: parent
                    color: "#1e293b"; radius: 20; border.color: "#334155"
                    Column {
                        anchors.centerIn: parent; spacing: 20; width: parent.width - 40
                        Text { text: "Washing Machine Control"; color: "white"; font.pixelSize: 22; font.bold: true; anchors.horizontalCenter: parent.horizontalCenter }
                        Row {
                            spacing: 30; anchors.horizontalCenter: parent.horizontalCenter
                            Text { text: "Power State:"; color: "#94a3b8"; font.pixelSize: 16; verticalAlignment: Text.AlignVCenter }
                            Switch { id: washingSwitch }
                        }
                        Button {
                            text: "Back to Devices"; width: parent.width; height: 40
                            background: Rectangle { color: "#334155"; radius: 8 }
                            contentItem: Text { text: parent.text; color: "white"; font.bold: true; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                            onClicked: stackView.pop()
                        }
                    }
                }
            }
        }

    }
}
